<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mystery Ticket"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilGenre"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Genre"
        android:layout_marginBottom="16dp"
        app:hintTextColor="#E50914"
        app:boxStrokeColor="#E50914">

        <AutoCompleteTextView
            android:id="@+id/actvGenre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="#FFFFFF"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDuration"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Duration"
        android:layout_marginBottom="16dp"
        app:hintTextColor="#E50914"
        app:boxStrokeColor="#E50914">

        <AutoCompleteTextView
            android:id="@+id/actvDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="#FFFFFF"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReleaseDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Release Year"
        android:layout_marginBottom="24dp"
        app:hintTextColor="#E50914"
        app:boxStrokeColor="#E50914">

        <AutoCompleteTextView
            android:id="@+id/actvReleaseDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="#FFFFFF"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Generate Mystery Ticket"
        android:textAllCaps="false"
        android:backgroundTint="#E50914"
        app:cornerRadius="4dp" />

    <LinearLayout
        android:id="@+id/llResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Mystery Boom Panes:"
            android:textColor="#B3B3B3"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <ImageView
            android:id="@+id/ivResultPoster"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Movie Title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMysteryPlay"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="Play"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            app:icon="@drawable/ic_play"
            app:iconTint="#000000"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:cornerRadius="4dp" />
    </LinearLayout>

</LinearLayout>
