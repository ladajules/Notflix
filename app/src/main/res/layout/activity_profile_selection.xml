<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Title -->
    <TextView
        android:id="@+id/tvWhoIsWatching"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Who's Watching?"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <!-- Edit Button -->
    <TextView
        android:id="@+id/tvEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="false"
        android:text="Edit"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridProfiles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvWhoIsWatching"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:columnCount="2"
        app:rowCount="3"
        app:useDefaultMargins="false">

        <!-- ── Profile 1 (always visible) ── -->
        <LinearLayout
            android:id="@+id/profile_card_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            app:layout_column="0"
            app:layout_row="0"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:id="@+id/ivProfile1"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="@drawable/profile_avatar_background"
                android:contentDescription="Profile 1 avatar"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvProfile1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Profile 1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                style="@style/NetflixText"
                tools:text="Profile 1" />

        </LinearLayout>

        <!-- ── Profile 2 (GONE until added) ── -->
        <LinearLayout
            android:id="@+id/profile_card_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            app:layout_column="1"
            app:layout_row="0"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:id="@+id/ivProfile2"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="@drawable/profile_avatar_background"
                android:contentDescription="Profile 2 avatar"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvProfile2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="Profile 2"
                style="@style/NetflixText"/>

        </LinearLayout>

        <!-- ── Profile 3 (GONE until added) ── -->
        <LinearLayout
            android:id="@+id/profile_card_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            app:layout_column="0"
            app:layout_row="1"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:id="@+id/ivProfile3"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="@drawable/profile_avatar_background"
                android:contentDescription="Profile 3 avatar"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvProfile3Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="Profile 3"
                style="@style/NetflixText"/>

        </LinearLayout>

        <!-- ── Profile 4 (GONE until added) ── -->
        <LinearLayout
            android:id="@+id/profile_card_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            app:layout_column="1"
            app:layout_row="1"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:id="@+id/ivProfile4"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="@drawable/profile_avatar_background"
                android:contentDescription="Profile 4 avatar"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvProfile4Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="Profile 4"
                style="@style/NetflixText"/>

        </LinearLayout>

        <!-- ── Profile 5 (GONE until added) ── -->
        <LinearLayout
            android:id="@+id/profile_card_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            app:layout_column="0"
            app:layout_row="2"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:id="@+id/ivProfile5"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="@drawable/profile_avatar_background"
                android:contentDescription="Profile 5 avatar"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvProfile5Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="Profile 5"
                style="@style/NetflixText"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/add_profile_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_column="1"
            app:layout_row="0"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <!-- Add Profile box -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/add_profile_background">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Add Profile" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/NetflixText"
                android:text="Add Profile"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>

    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>